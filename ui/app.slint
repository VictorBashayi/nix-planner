import { Theme, TaskItem, BucketItem, ProfileItem, MoveOption, Icon, IconButton, Check, MenuRow, MenuLabel, DropZone, Chip } from "theme.slint";
import { TaskRow, Editor } from "task_row.slint";
export { Theme, TaskItem, BucketItem, ProfileItem }

export component AppWindow inherits Window {
    title: "Nix Planner";
    no-frame: true;
    always-on-top: root.pinned;
    preferred-width: 400px;
    preferred-height: 640px;
    min-width: 320px;
    min-height: 360px;
    background: Theme.canvas;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;

    in property <[BucketItem]> buckets;
    in property <int> selected: 0;
    in property <string> status;
    in property <bool> has-done;
    // Set from Rust after a delete or clear; the footer then offers Undo for a while.
    in-out property <bool> offer-undo;
    in property <string> today;
    in-out property <bool> pinned: true;
    in property <[ProfileItem]> profiles;
    in property <string> profile-name;
    // How many tasks the current profile holds, done ones included.
    in property <int> profile-tasks;

    callback select-profile(int);
    callback next-profile();
    callback add-profile(string);
    callback rename-profile(string);
    // Deletes the current profile and its tasks.
    callback delete-profile();
    callback send-task(int, int);
    // Asks Rust to pin and shape the widget again after it was re-shown.
    callback tend-requested();

    callback add-task(string);
    callback select-bucket(int);
    callback toggle-task(int);
    callback delete-task(int);
    callback move-task(int, string, int);
    callback edit-live(int, bool, string);
    callback edit-finished();
    callback edit-cancelled(int, string, string);
    callback toggle-collapsed(string);
    callback show-done();
    callback clear-done();
    callback undo();
    callback redo();
    callback search(string);
    // What the trailing date words of the typed text mean ("Due tomorrow, 3:00 pm"), or "".
    pure callback due-preview(string) -> string;
    callback hide-window();
    callback start-move();
    callback start-resize();
    callback toggle-requested();
    callback show-requested();
    // "Mark done" on a reminder toast; unlike toggle-task it never reopens a task.
    callback complete-task(int);
    callback quit-requested();

    // Drag state. Positions are window coordinates.
    property <int> drag-id: -1;
    property <bool> dragging: root.drag-id >= 0;
    property <string> drag-title;
    property <length> drag-x;
    property <length> drag-y;
    property <length> grab-x;
    property <length> grab-y;
    property <length> ghost-width;
    property <string> drop-bucket;
    property <int> drop-index: -1;
    property <length> list-top: list.absolute-position.y;
    property <bool> drag-in-list: root.dragging && root.drag-y >= root.list-top && root.drag-y < root.list-top + list.height;

    // The add box and the search box share a slot; Ctrl+F swaps them.
    property <bool> searching;
    property <bool> filtering: search-input.text != "";

    public function focus-input() {
        if (root.searching) {
            search-input.focus();
        } else {
            add-input.focus();
        }
    }

    function open-search() {
        root.searching = true;
        search-input.focus();
    }

    function close-search() {
        search-input.text = "";
        root.search("");
        root.searching = false;
        add-input.focus();
    }

    // The profile name in the title bar turns into a text box: 1 names a new profile,
    // 2 renames the current one.
    property <int> naming;
    // The mode picked in the profile menu. The menu hands focus back as it closes,
    // which would end the naming at once, so the text box opens a moment later.
    property <int> naming-next;
    property <bool> delete-armed;

    function name-profile(mode: int) {
        name-input.text = mode == 2 ? root.profile-name : "";
        root.naming = mode;
        name-input.focus();
        name-input.select-all();
    }

    function set-drop(key: string, index: int) {
        root.drop-bucket = key;
        root.drop-index = index;
    }

    VerticalLayout {
        // Title bar
        Rectangle {
            height: 48px;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.start-move();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 10px;
                padding-top: 10px;
                spacing: 2px;
                // The profile on show; click for the others.
                if root.naming == 0: Rectangle {
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        spacing: 5px;
                        Text {
                            text: root.profile-name;
                            font-family: Theme.serif;
                            font-size: 15px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            padding-top: 2px;
                            Icon {
                                width: 11px;
                                height: 11px;
                                commands: "M 3.5 6 L 8 10.5 L 12.5 6";
                                stroke: profile-ta.has-hover ? Theme.text : Theme.text-muted;
                            }
                        }
                    }

                    profile-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            profile-menu.show();
                        }
                    }
                }

                name-input := TextInput {
                    visible: root.naming != 0;
                    enabled: root.naming != 0;
                    horizontal-stretch: 0;
                    width: root.naming != 0 ? 130px : 0px;
                    vertical-alignment: center;
                    font-family: Theme.serif;
                    font-size: 15px;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accepted => {
                        if (root.naming == 1) {
                            root.add-profile(self.text);
                        } else if (root.naming == 2) {
                            root.rename-profile(self.text);
                        }
                        root.naming = 0;
                        root.focus-input();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.naming = 0;
                            root.focus-input();
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.naming = 0;
                        }
                    }
                    if self.text == "" && root.naming != 0: Text {
                        height: parent.height;
                        text: "Profile name";
                        font-family: Theme.serif;
                        font-size: 15px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 8px;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.today;
                    font-size: 11.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        active: root.searching;
                        icon: "M 7 3 A 4 4 0 1 0 7 11 A 4 4 0 1 0 7 3 M 10 10 L 13 13";
                        clicked => {
                            if (root.searching) {
                                root.close-search();
                            } else {
                                root.open-search();
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        active: root.pinned;
                        icon: "M 6 2.5 L 10 2.5 M 6.8 2.5 L 6.3 7 L 4.5 9 L 11.5 9 L 9.7 7 L 9.2 2.5 M 8 9 L 8 13.5";
                        clicked => {
                            root.pinned = !root.pinned;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "M 4 8 L 12 8";
                        clicked => {
                            root.hide-window();
                        }
                    }
                }
            }
        }

        // Quick add
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 6px;
            spacing: 10px;

            Rectangle {
                height: 42px;
                border-radius: 10px;
                background: Theme.card;
                border-width: 1px;
                border-color: add-input.has-focus || search-input.has-focus ? Theme.accent : Theme.hairline;

                add-input := TextInput {
                    visible: !root.searching;
                    enabled: !root.searching;
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accepted => {
                        if (self.text != "") {
                            root.add-task(self.text);
                            self.text = "";
                        }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.hide-window();
                            return accept;
                        }
                        // With an empty box, Ctrl+Z / Ctrl+Y act on tasks; otherwise on the typing.
                        if (event.modifiers.control && self.text == "") {
                            if (event.text == "z" && !event.modifiers.shift) {
                                root.undo();
                                return accept;
                            }
                            if (event.text == "y" || ((event.text == "z" || event.text == "Z") && event.modifiers.shift)) {
                                root.redo();
                                return accept;
                            }
                        }
                        if (event.modifiers.control && event.text == "f") {
                            root.open-search();
                            return accept;
                        }
                        if (event.modifiers.control && event.text == Key.Tab) {
                            root.next-profile();
                            return accept;
                        }
                        if (event.modifiers.control && event.text == "1") {
                            root.select-bucket(0);
                            return accept;
                        }
                        if (event.modifiers.control && event.text == "2") {
                            root.select-bucket(1);
                            return accept;
                        }
                        if (event.modifiers.control && event.text == "3") {
                            root.select-bucket(2);
                            return accept;
                        }
                        reject
                    }
                }

                search-input := TextInput {
                    visible: root.searching;
                    enabled: root.searching;
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    edited => {
                        root.search(self.text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-search();
                            return accept;
                        }
                        reject
                    }
                }

                if (root.searching ? search-input.text : add-input.text) == "": Text {
                    x: 14px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: root.searching ? "Search tasks" : "Add a task";
                    font-size: 14px;
                    color: Theme.text-muted;
                }
            }

            // Bucket chips, with the due-date preview filling the rest of the row.
            HorizontalLayout {
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 4px;
                    for chip[i] in [
                        { key: "now", title: "Today" },
                        { key: "soon", title: "This week" },
                        { key: "later", title: "Someday" },
                    ]: Chip {
                        label: chip.title;
                        key: chip.key;
                        selected: i == root.selected;
                        clicked => {
                            root.select-bucket(i);
                            add-input.focus();
                        }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.searching ? "" : root.due-preview(add-input.text);
                    font-size: 11.5px;
                    color: Theme.accent;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Buckets
        list := Flickable {
            content-height: column.preferred-height;
            // Without this the list's own height caps the window's, and a short list
            // (an empty profile) shrinks the window to fit.
            max-height: 100000px;
            column := VerticalLayout {
                width: list.width;
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 12px;

                if root.filtering && root.buckets.length == 0: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 46px;
                        vertical-alignment: center;
                        text: "No tasks match.";
                        font-size: 12.5px;
                        color: Theme.text-muted;
                    }
                }

                for bucket in root.buckets: VerticalLayout {
                    header := Rectangle {
                        height: 46px;
                        DropZone {
                            drag-active: root.drag-in-list;
                            drag-y: root.drag-y;
                            drop-index: 0;
                            hover-drop(i) => {
                                root.set-drop(bucket.key, i);
                            }
                        }

                        // Search shows every matching bucket open, so collapsing waits until it ends.
                        header-ta := TouchArea {
                            enabled: !root.filtering;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                root.toggle-collapsed(bucket.key);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            padding-top: 12px;
                            spacing: 8px;
                            Text {
                                text: bucket.title;
                                font-family: Theme.serif;
                                font-size: 19px;
                                color: Theme.strength(bucket.key);
                                vertical-alignment: center;
                            }

                            Rectangle { }

                            // Two clicks to clear: the first arms it for 3 seconds. Hidden while
                            // searching, since it clears every done task, not just the matches.
                            if bucket.key == "done" && bucket.tasks.length > 0 && !root.filtering: Text {
                                text: root.clear-armed ? "Clear " + bucket.tasks.length + "?" : "Clear";
                                font-size: 12px;
                                color: root.clear-armed ? Theme.accent : clear-ta.has-hover ? Theme.text : Theme.text-muted;
                                vertical-alignment: center;
                                clear-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.clear-armed) {
                                            root.clear-armed = false;
                                            root.clear-done();
                                        } else {
                                            root.clear-armed = true;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: bucket.tasks.length;
                                font-size: 12px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    width: 12px;
                                    height: 12px;
                                    commands: bucket.collapsed ? "M 6 3.5 L 10.5 8 L 6 12.5" : "M 3.5 6 L 8 10.5 L 12.5 6";
                                    stroke: header-ta.has-hover ? Theme.text : Theme.text-muted;
                                }
                            }
                        }

                        if root.dragging && root.drop-bucket == bucket.key && bucket.collapsed: Rectangle {
                            x: 18px;
                            y: parent.height - 3px;
                            width: parent.width - 36px;
                            height: 2px;
                            background: Theme.accent;
                        }
                    }

                    if !bucket.collapsed: VerticalLayout {
                        for task[i] in bucket.tasks: TaskRow {
                            task: task;
                            bucket-key: bucket.key;
                            index: i;
                            drag-active: root.drag-in-list;
                            drag-y: root.drag-y;
                            lifted: root.drag-id == task.id;
                            draggable: !root.filtering;
                            profiles: root.profiles;
                            sent(id, profile) => {
                                root.send-task(id, profile);
                            }
                            drop-line: root.dragging && root.drop-bucket == bucket.key && root.drop-index == i;
                            toggled(id) => {
                                root.toggle-task(id);
                            }
                            deleted(id) => {
                                root.delete-task(id);
                            }
                            moved(id, key) => {
                                root.move-task(id, key, 0);
                            }
                            edit-live(id, is-desc, text) => {
                                root.edit-live(id, is-desc, text);
                            }
                            edit-finished => {
                                root.edit-finished();
                            }
                            edit-cancelled(id, title, desc) => {
                                root.edit-cancelled(id, title, desc);
                            }
                            hover-drop(index) => {
                                root.set-drop(bucket.key, index);
                            }
                            drag-start(id, title, gx, gy, w) => {
                                root.drag-title = title;
                                root.grab-x = gx;
                                root.grab-y = gy;
                                root.ghost-width = w;
                                root.drop-bucket = "";
                                root.drop-index = -1;
                                root.drag-id = id;
                            }
                            drag-move(x, y) => {
                                root.drag-x = x;
                                root.drag-y = y;
                            }
                            drag-end => {
                                if (root.drag-in-list && root.drop-bucket != "") {
                                    root.move-task(root.drag-id, root.drop-bucket, root.drop-index);
                                }
                                root.drag-id = -1;
                            }
                            drag-cancelled => {
                                root.drag-id = -1;
                            }
                        }

                        DropZone {
                            height: bucket.tasks.length == 0 ? 36px : 10px;
                            drag-active: root.drag-in-list;
                            drag-y: root.drag-y;
                            drop-index: bucket.tasks.length;
                            hover-drop(i) => {
                                root.set-drop(bucket.key, i);
                            }
                            if bucket.tasks.length == 0: Text {
                                x: 38px;
                                y: 4px;
                                text: bucket.empty-text;
                                font-size: 12.5px;
                                color: Theme.text-muted;
                            }
                            if root.dragging && root.drop-bucket == bucket.key && root.drop-index == bucket.tasks.length
                                && bucket.tasks.length > 0: Rectangle {
                                x: 8px;
                                y: 0px;
                                width: parent.width - 16px;
                                height: 2px;
                                background: Theme.accent;
                            }
                        }
                    }
                }
            }
        }

        // Status
        Rectangle {
            height: 36px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.hairline;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 26px;
                Text {
                    text: root.status;
                    font-size: 11.5px;
                    color: status-ta.has-hover ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                    // Opens Done and scrolls to it; Done is the last bucket, so that's the bottom.
                    status-ta := TouchArea {
                        enabled: root.has-done;
                        mouse-cursor: root.has-done ? pointer : default;
                        clicked => {
                            root.show-done();
                            root.revealing-done = true;
                        }
                    }
                }

                Rectangle { }

                // Second click of deleting a profile; the first was in the profile menu.
                if root.delete-armed: Text {
                    text: "Delete " + root.profile-name + (root.profile-tasks == 0 ? "?" : root.profile-tasks == 1 ? " and its task?" : " and its " + root.profile-tasks + " tasks?");
                    font-size: 11.5px;
                    color: delete-ta.has-hover ? Theme.text : Theme.danger;
                    vertical-alignment: center;
                    delete-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.delete-armed = false;
                            root.delete-profile();
                        }
                    }
                }

                if !root.offer-undo && !root.delete-armed: Text {
                    text: "Alt+P shows and hides";
                    font-size: 11.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                if root.offer-undo && !root.delete-armed: Text {
                    text: "Undo";
                    font-size: 11.5px;
                    color: undo-ta.has-hover ? Theme.text : Theme.accent;
                    vertical-alignment: center;
                    undo-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.undo();
                        }
                    }
                }
            }

            // Resize grip
            Rectangle {
                x: parent.width - 18px;
                y: parent.height - 18px;
                width: 16px;
                height: 16px;
                Icon {
                    width: 10px;
                    height: 10px;
                    commands: "M 14 6 L 6 14 M 14 11 L 11 14";
                    stroke: grip.has-hover ? Theme.text-muted : Theme.text-muted;
                    stroke-width: 1.2px;
                }
                grip := TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start-resize();
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 6s;
        running: root.offer-undo;
        triggered => {
            root.offer-undo = false;
        }
    }

    Timer {
        interval: 5s;
        running: root.delete-armed;
        triggered => {
            root.delete-armed = false;
        }
    }

    Timer {
        interval: 30ms;
        running: root.naming-next != 0;
        triggered => {
            root.name-profile(root.naming-next);
            root.naming-next = 0;
        }
    }

    profile-menu := PopupWindow {
        x: 12px;
        y: 42px;
        width: 190px;
        Rectangle {
            background: Theme.card;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #2E221B26;
            VerticalLayout {
                padding: 4px;
                MenuLabel {
                    text: "Profiles";
                }
                for p in root.profiles: MenuRow {
                    label: p.name;
                    detail: p.open > 0 ? p.open : "";
                    dot: p.current ? Theme.accent : Theme.accent-soft;
                    clicked => {
                        root.delete-armed = false;
                        root.select-profile(p.id);
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        x: 8px;
                        y: 4px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: Theme.hairline;
                    }
                }

                MenuRow {
                    label: "New profile";
                    clicked => {
                        root.naming-next = 1;
                    }
                }

                MenuRow {
                    label: "Rename " + root.profile-name;
                    clicked => {
                        root.naming-next = 2;
                    }
                }

                if root.profiles.length > 1: MenuRow {
                    label: "Delete " + root.profile-name;
                    ink: Theme.danger;
                    clicked => {
                        root.delete-armed = true;
                    }
                }
            }
        }
    }

    property <bool> clear-armed;
    Timer {
        interval: 3s;
        running: root.clear-armed;
        triggered => {
            root.clear-armed = false;
        }
    }

    // Scroll to the bottom once the newly expanded Done rows are laid out; scrolling in the
    // click handler itself would use the list's height from before they existed.
    property <bool> revealing-done;
    Timer {
        interval: 30ms;
        running: root.revealing-done;
        triggered => {
            root.revealing-done = false;
            list.content-y = min(0px, list.height - list.content-height);
        }
    }

    // Scroll the list while dragging near its edges.
    Timer {
        interval: 16ms;
        running: root.dragging && (root.drag-y < root.list-top + 28px || root.drag-y > root.list-top + list.height - 28px);
        triggered => {
            if (root.drag-y < root.list-top + 28px) {
                list.content-y = min(0px, list.content-y + 7px);
            } else {
                list.content-y = max(min(0px, list.height - list.content-height), list.content-y - 7px);
            }
        }
    }

    // The task being dragged.
    if root.dragging: Rectangle {
        x: root.drag-x - root.grab-x;
        y: root.drag-y - root.grab-y;
        width: root.ghost-width;
        height: 38px;
        border-radius: 8px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.accent-soft;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #2E221B2E;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 10px;
            Rectangle {
                y: (parent.height - 18px) / 2;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1.5px;
                border-color: Theme.accent;
            }
            Text {
                text: root.drag-title;
                font-size: 13.5px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Text with a 1px shadow in the opposite tone, so it reads on any wallpaper.
// The root draws the shadow; the child draws the ink 1px up-left of it.
component InkText inherits Text {
    in property <bool> dark-bg;
    in property <color> ink: root.dark-bg ? #FFFFFF : Theme.text;
    color: root.dark-bg ? #000000a0 : #FFFFFFc0;
    Text {
        x: -1px;
        y: -1px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: root.font-family;
        font-size: root.font-size;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        overflow: root.overflow;
        color: root.ink;
    }
}

// Transparent desktop card: today's open tasks, tick to complete.
export component WidgetWindow inherits Window {
    title: "Nix Planner widget";
    no-frame: true;
    // Slint turns a press near an edge into Windows' own resize, which draws an outline
    // box over the widget; the grip does the resizing instead. Negative, not zero: the
    // cursor outruns the window while the grip grows it, and 0 counts that as "on the edge".
    resize-border-width: -100px;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;
    preferred-width: 260px;
    min-width: 180px;
    // Six rows to start with; resizing shows more or fewer.
    preferred-height: 222px;
    min-height: 90px;

    in property <[TaskItem]> tasks;
    in property <string> today;
    // Set from Rust after sampling the wallpaper behind the widget.
    in property <bool> dark-bg;
    // The profile on show, or "" when there is only one.
    in property <string> profile;

    callback toggle-task(int);
    callback open-app();
    callback start-move();
    // Resized by the grip itself: Windows' own resize loop draws an outline box over the
    // widget's see-through window.
    callback start-resize();
    callback resize-drag();

    // How far down the header and rows reach. Rust cuts the window to this (plus the
    // grip), so clicks below it land on the desktop; `reshape` says it needs redoing.
    out property <length> ink-height: 14px + 22px + 9px + max(1, rows.shown + (rows.shown < root.tasks.length ? 1 : 0)) * rows.row-h;
    callback reshape();
    changed ink-height => {
        root.reshape();
    }
    changed width => {
        root.reshape();
    }
    changed height => {
        root.reshape();
    }

    // Resize grip, larger than the main window's so it is easy to catch.
    Rectangle {
        x: parent.width - 24px;
        y: parent.height - 24px;
        width: 24px;
        height: 24px;
        Icon {
            width: 12px;
            height: 12px;
            commands: "M 14 6 L 6 14 M 14 11 L 11 14";
            stroke: root.dark-bg ? #FFFFFF : Theme.text;
            stroke-width: 1.4px;
            opacity: grip.has-hover ? 0.9 : 0.4;
        }
        grip := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize();
                }
            }
            moved => {
                if (self.pressed) {
                    root.resize-drag();
                }
            }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 9px;
        Rectangle {
            height: 22px;
            HorizontalLayout {
                spacing: 8px;
                InkText {
                    text: "Today";
                    font-family: Theme.serif;
                    font-size: 16px;
                    dark-bg: root.dark-bg;
                    ink: root.dark-bg ? #E8C9A6 : Theme.strength("now");
                }

                InkText {
                    text: root.profile == "" ? root.today : root.profile + " · " + root.today;
                    font-size: 11px;
                    dark-bg: root.dark-bg;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            TouchArea {
                double-clicked => {
                    root.open-app();
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.start-move();
                    }
                }
            }
        }

        // Rows are placed by hand rather than in a layout, so how many fit can follow the
        // window's height without the content's size feeding back into it.
        rows := Rectangle {
            property <length> row-h: 27px;
            property <int> shown: root.tasks.length * self.row-h <= self.height ? root.tasks.length
                : max(0, floor((self.height - 18px) / self.row-h));

            if root.tasks.length == 0: InkText {
                y: 0;
                height: 18px;
                text: "Nothing for today.";
                dark-bg: root.dark-bg;
            }
            for t[i] in root.tasks: HorizontalLayout {
                y: i * rows.row-h;
                height: 18px;
                visible: i < rows.shown;
                spacing: 10px;
                Check {
                    tint: root.dark-bg ? #FFFFFFc0 : Theme.text-muted;
                    toggled => {
                        root.toggle-task(t.id);
                    }
                }

                InkText {
                    text: t.title;
                    dark-bg: root.dark-bg;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if t.when != "": InkText {
                    text: t.when;
                    font-size: 11px;
                    dark-bg: root.dark-bg;
                    ink: t.overdue ? (root.dark-bg ? #F2A48F : Theme.danger)
                        : t.soon ? (root.dark-bg ? #E8C9A6 : Theme.accent)
                        : (root.dark-bg ? #FFFFFF : Theme.text);
                    vertical-alignment: center;
                }
            }
            if rows.shown < root.tasks.length: InkText {
                y: rows.shown * rows.row-h;
                height: 18px;
                text: "+" + (root.tasks.length - rows.shown) + " more";
                font-size: 11px;
                dark-bg: root.dark-bg;
            }
        }
    }
}
