import { Theme, TaskItem, BucketItem, ProfileItem, SideBucket, Swatch, MoveOption, Icon, IconButton, Check, MenuRow, MenuLabel, DropZone, Chip } from "theme.slint";
import { TaskRow, Editor } from "task_row.slint";
import { Sidebar, BucketIcons } from "sidebar.slint";
export { Theme, TaskItem, BucketItem, ProfileItem, SideBucket, Swatch }

export component AppWindow inherits Window {
    title: "Nix Planner";
    no-frame: true;
    always-on-top: root.pinned;
    preferred-width: 540px;
    preferred-height: 640px;
    min-width: 460px;
    min-height: 360px;
    background: Theme.chrome;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;

    // The page on show; while searching with text, every bucket that has matches.
    in property <[BucketItem]> buckets;
    // Key of the page on show: "now", "soon", "later" or "done".
    in property <string> page: "now";
    in property <[SideBucket]> side-buckets;
    // Set from Rust after a delete or clear; Undo is then offered for a while.
    in-out property <bool> offer-undo;
    in property <string> today;
    in-out property <bool> pinned: true;
    in property <[ProfileItem]> profiles;

    callback select-profile(int);
    callback next-profile();
    callback add-profile(string);
    callback rename-profile-id(int, string);
    // Deletes a profile and its tasks.
    callback delete-profile-id(int);
    callback set-profile-colour(int, string);
    in property <[Swatch]> swatches;
    callback send-task(int, int);
    // A task dropped on a sidebar bucket (task id, bucket key) or profile (task id, profile id).
    callback drop-on-page(int, string);
    callback drop-on-profile(int, int);
    // Asks Rust to pin and shape the widget again after it was re-shown.
    callback tend-requested();

    callback add-task(string);
    callback select-page(string);
    callback toggle-task(int);
    callback delete-task(int);
    callback move-task(int, string, int);
    callback edit-live(int, bool, string);
    callback edit-finished();
    callback edit-cancelled(int, string, string);
    callback clear-done();
    callback undo();
    callback redo();
    callback search(string);
    // What the trailing date words of the typed text mean ("Due tomorrow, 3:00 pm"), or "".
    pure callback due-preview(string) -> string;
    callback hide-window();
    callback start-move();
    callback start-resize();
    callback toggle-requested();
    callback show-requested();
    // "Mark done" on a reminder toast; unlike toggle-task it never reopens a task.
    callback complete-task(int);
    callback quit-requested();

    // Drag state. Positions are window coordinates.
    property <int> drag-id: -1;
    property <bool> dragging: root.drag-id >= 0;
    property <string> drag-title;
    property <length> drag-x;
    property <length> drag-y;
    property <length> grab-x;
    property <length> grab-y;
    property <length> ghost-width;
    property <string> drop-bucket;
    property <int> drop-index: -1;
    property <length> list-top: list.absolute-position.y;
    property <bool> drag-in-list: root.dragging && root.drag-x >= main.absolute-position.x
        && root.drag-y >= root.list-top && root.drag-y < root.list-top + list.height;

    // The profile whose menu is open, where it opened, and its two-step states.
    property <ProfileItem> menu-profile;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> menu-renaming;
    property <bool> menu-delete-armed;

    // The add box and the search box share a slot; Ctrl+F swaps them.
    property <bool> searching;
    property <bool> filtering: search-input.text != "";
    property <bool> on-done: root.page == "done";
    property <int> page-count: root.buckets.length > 0 ? root.buckets[0].tasks.length : 0;

    public function focus-input() {
        if (root.searching) {
            search-input.focus();
        } else if (root.on-done) {
            keys.focus();
        } else {
            add-input.focus();
        }
    }

    function open-search() {
        root.searching = true;
        search-input.focus();
    }

    function close-search() {
        search-input.text = "";
        root.search("");
        root.searching = false;
        root.focus-input();
    }

    function go(key: string) {
        if (root.searching) {
            search-input.text = "";
            root.search("");
            root.searching = false;
        }
        root.clear-armed = false;
        root.select-page(key);
        root.focus-input();
    }

    function open-profile-menu(p: ProfileItem, x: length, y: length) {
        root.menu-profile = p;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-renaming = false;
        root.menu-delete-armed = false;
        profile-menu.show();
    }

    function set-drop(key: string, index: int) {
        root.drop-bucket = key;
        root.drop-index = index;
    }

    function title-of(key: string) -> string {
        if (key == "now") {
            return "Today";
        }
        if (key == "soon") {
            return "This week";
        }
        if (key == "later") {
            return "Someday";
        }
        return "Done";
    }

    // Shortcuts that work wherever focus is; text boxes pass on keys they don't use.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.hide-window();
                return accept;
            }
            if (event.modifiers.control) {
                if (event.text == "f") {
                    root.open-search();
                    return accept;
                }
                if (event.text == Key.Tab) {
                    root.next-profile();
                    return accept;
                }
                if (event.text == "1") {
                    root.go("now");
                    return accept;
                }
                if (event.text == "2") {
                    root.go("soon");
                    return accept;
                }
                if (event.text == "3") {
                    root.go("later");
                    return accept;
                }
                if (event.text == "4") {
                    root.go("done");
                    return accept;
                }
                if (event.text == "z" && !event.modifiers.shift) {
                    root.undo();
                    return accept;
                }
                if (event.text == "y" || ((event.text == "z" || event.text == "Z") && event.modifiers.shift)) {
                    root.redo();
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            side := Sidebar {
                profiles: root.profiles;
                buckets: root.side-buckets;
                drag-active: root.dragging;
                drag-x: root.drag-x;
                drag-y: root.drag-y;
                profile-menu(p, x, y) => {
                    root.open-profile-menu(p, x, y);
                }
                select-profile(id) => {
                    root.select-profile(id);
                    root.focus-input();
                }
                select-page(key) => {
                    root.go(key);
                }
                add-profile(name) => {
                    root.add-profile(name);
                }
                done-naming => {
                    root.focus-input();
                }
                start-move => {
                    root.start-move();
                }
            }

            main := Rectangle {
                background: Theme.canvas;
                border-top-left-radius: 16px;

                VerticalLayout {
                    // Title bar
                    Rectangle {
                        height: 52px;
                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.start-move();
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 10px;
                            spacing: 4px;
                            Text {
                                text: root.searching ? "Search" : root.title-of(root.page);
                                font-family: Theme.serif;
                                font-size: 20px;
                                color: root.searching ? Theme.text : Theme.strength(root.page);
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 8px;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.today;
                                font-size: 11.5px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // Two clicks to clear: the first arms it for 3 seconds.
                            if root.on-done && !root.searching && root.page-count > 0: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.clear-armed ? Theme.accent-soft : clear-ta.has-hover ? Theme.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: root.clear-armed ? "Clear " + root.page-count + "?" : "Clear";
                                            font-size: 12.5px;
                                            color: root.clear-armed ? Theme.text : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                    clear-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.clear-armed) {
                                                root.clear-armed = false;
                                                root.clear-done();
                                            } else {
                                                root.clear-armed = true;
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    active: root.searching;
                                    icon: "M 7 3 A 4 4 0 1 0 7 11 A 4 4 0 1 0 7 3 M 10 10 L 13 13";
                                    clicked => {
                                        if (root.searching) {
                                            root.close-search();
                                        } else {
                                            root.open-search();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    active: root.pinned;
                                    icon: "M 6 2.5 L 10 2.5 M 6.8 2.5 L 6.3 7 L 4.5 9 L 11.5 9 L 9.7 7 L 9.2 2.5 M 8 9 L 8 13.5";
                                    clicked => {
                                        root.pinned = !root.pinned;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: "M 4 8 L 12 8";
                                    clicked => {
                                        root.hide-window();
                                    }
                                }
                            }
                        }
                    }

                    // Add box, or the search box; Done has no add box.
                    if !root.on-done || root.searching: VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        Rectangle {
                            height: 44px;
                            border-radius: 22px;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: add-input.has-focus || search-input.has-focus ? Theme.accent : transparent;
                        }
                    }

                    // Tasks
                    list := Flickable {
                        content-height: column.preferred-height;
                        // Without this the list's own height caps the window's, and a short list
                        // (an empty page) shrinks the window to fit.
                        max-height: 100000px;
                        column := VerticalLayout {
                            width: list.width;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 16px;
                            spacing: 8px;

                            if root.filtering && root.buckets.length == 0: Text {
                                height: 120px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: "No tasks match";
                                font-size: 13px;
                                color: Theme.text-muted;
                            }

                            for bucket in root.buckets: VerticalLayout {
                                spacing: 4px;
                                if root.filtering: Text {
                                    x: 8px;
                                    height: 28px;
                                    text: bucket.title;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.strength(bucket.key);
                                    vertical-alignment: bottom;
                                }

                                if bucket.tasks.length == 0 && !root.filtering: VerticalLayout {
                                    padding-top: 96px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Icon {
                                            width: 32px;
                                            height: 32px;
                                            commands: BucketIcons.of(bucket.key);
                                            stroke: Theme.strength(bucket.key);
                                            stroke-width: 1.5px;
                                        }
                                    }
                                    Text {
                                        horizontal-alignment: center;
                                        text: bucket.empty-text;
                                        font-size: 13px;
                                        color: Theme.text-muted;
                                    }
                                }

                                if bucket.tasks.length > 0: Rectangle {
                                    background: Theme.card;
                                    border-radius: 16px;
                                    VerticalLayout {
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        DropZone {
                                            height: 6px;
                                            drag-active: root.drag-in-list;
                                            drag-y: root.drag-y;
                                            drop-index: 0;
                                            hover-drop(i) => {
                                                root.set-drop(bucket.key, i);
                                            }
                                        }

                                        for task[i] in bucket.tasks: VerticalLayout {
                                            if i > 0: Rectangle {
                                                height: 1px;
                                                Rectangle {
                                                    x: 52px;
                                                    width: parent.width - 64px;
                                                    height: 1px;
                                                    background: Theme.hairline;
                                                }
                                            }
                                            TaskRow {
                                                task: task;
                                                bucket-key: bucket.key;
                                                index: i;
                                                drag-active: root.drag-in-list;
                                                drag-y: root.drag-y;
                                                lifted: root.drag-id == task.id;
                                                draggable: !root.filtering;
                                                profiles: root.profiles;
                                                sent(id, profile) => {
                                                    root.send-task(id, profile);
                                                }
                                                drop-line: root.dragging && root.drop-bucket == bucket.key && root.drop-index == i;
                                                toggled(id) => {
                                                    root.toggle-task(id);
                                                }
                                                deleted(id) => {
                                                    root.delete-task(id);
                                                }
                                                moved(id, key) => {
                                                    root.move-task(id, key, 0);
                                                }
                                                edit-live(id, is-desc, text) => {
                                                    root.edit-live(id, is-desc, text);
                                                }
                                                edit-finished => {
                                                    root.edit-finished();
                                                }
                                                edit-cancelled(id, title, desc) => {
                                                    root.edit-cancelled(id, title, desc);
                                                }
                                                hover-drop(index) => {
                                                    root.set-drop(bucket.key, index);
                                                }
                                                drag-start(id, title, gx, gy, w) => {
                                                    root.drag-title = title;
                                                    root.grab-x = gx;
                                                    root.grab-y = gy;
                                                    root.ghost-width = w;
                                                    root.drop-bucket = "";
                                                    root.drop-index = -1;
                                                    root.drag-id = id;
                                                }
                                                drag-move(x, y) => {
                                                    root.drag-x = x;
                                                    root.drag-y = y;
                                                }
                                                drag-end => {
                                                    if (side.drop-page != "") {
                                                        root.drop-on-page(root.drag-id, side.drop-page);
                                                    } else if (side.drop-profile >= 0) {
                                                        root.drop-on-profile(root.drag-id, side.drop-profile);
                                                    } else if (root.drag-in-list && root.drop-bucket != "") {
                                                        root.move-task(root.drag-id, root.drop-bucket, root.drop-index);
                                                    }
                                                    side.drop-page = "";
                                                    side.drop-profile = -1;
                                                    root.drag-id = -1;
                                                }
                                                drag-cancelled => {
                                                    side.drop-page = "";
                                                    side.drop-profile = -1;
                                                    root.drag-id = -1;
                                                }
                                            }
                                        }

                                        DropZone {
                                            height: 8px;
                                            drag-active: root.drag-in-list;
                                            drag-y: root.drag-y;
                                            drop-index: bucket.tasks.length;
                                            hover-drop(i) => {
                                                root.set-drop(bucket.key, i);
                                            }
                                            if root.dragging && root.drop-bucket == bucket.key && root.drop-index == bucket.tasks.length: Rectangle {
                                                x: 12px;
                                                y: 0px;
                                                width: parent.width - 24px;
                                                height: 2px;
                                                background: Theme.accent;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Text boxes live outside the `if` above so they can always take focus.
                add-input := TextInput {
                    visible: !root.searching && !root.on-done;
                    enabled: !root.searching && !root.on-done;
                    x: 16px + 18px;
                    y: 52px + 4px;
                    width: main.width - 32px - 36px - preview.width;
                    height: 44px;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accepted => {
                        if (self.text != "") {
                            root.add-task(self.text);
                            self.text = "";
                        }
                    }
                    key-pressed(event) => {
                        // With an empty box, Ctrl+Z / Ctrl+Y act on tasks; otherwise the box's own
                        // undo takes them. Handled here because the box keeps them from the window.
                        if (event.modifiers.control && self.text == "") {
                            if (event.text == "z" && !event.modifiers.shift) {
                                root.undo();
                                return accept;
                            }
                            if (event.text == "y" || ((event.text == "z" || event.text == "Z") && event.modifiers.shift)) {
                                root.redo();
                                return accept;
                            }
                        }
                        reject
                    }
                }

                search-input := TextInput {
                    visible: root.searching;
                    enabled: root.searching;
                    x: 16px + 18px;
                    y: 52px + 4px;
                    width: main.width - 32px - 36px;
                    height: 44px;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    edited => {
                        root.search(self.text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-search();
                            return accept;
                        }
                        reject
                    }
                }

                if (!root.on-done || root.searching) && (root.searching ? search-input.text : add-input.text) == "": Text {
                    x: 16px + 18px;
                    y: 52px + 4px;
                    height: 44px;
                    vertical-alignment: center;
                    text: root.searching ? "Search tasks" : "Add a task";
                    font-size: 14px;
                    color: Theme.text-muted;
                }

                preview := Text {
                    visible: !root.searching && !root.on-done;
                    x: main.width - 16px - 18px - self.width;
                    y: 52px + 4px;
                    height: 44px;
                    text: root.searching || root.on-done ? "" : root.due-preview(add-input.text);
                    font-size: 11.5px;
                    color: Theme.accent;
                    vertical-alignment: center;
                }

                if root.offer-undo: Rectangle {
                    x: (main.width - self.width) / 2;
                    y: main.height - 52px;
                    width: 96px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.accent-soft;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 4px;
                    drop-shadow-color: #00000026;
                    Text {
                        text: "Undo";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.offer-undo = false;
                            root.undo();
                        }
                    }
                }

                // Resize grip
                Rectangle {
                    x: main.width - 32px;
                    y: main.height - 32px;
                    width: 32px;
                    height: 32px;
                    Icon {
                        x: 18px;
                        y: 18px;
                        width: 10px;
                        height: 10px;
                        commands: "M 14 6 L 6 14 M 14 11 L 11 14";
                        stroke: Theme.text-muted;
                        stroke-width: 1.2px;
                    }
                    TouchArea {
                        mouse-cursor: nwse-resize;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.start-resize();
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 6s;
        running: root.offer-undo;
        triggered => {
            root.offer-undo = false;
        }
    }

    property <bool> clear-armed;
    Timer {
        interval: 3s;
        running: root.clear-armed;
        triggered => {
            root.clear-armed = false;
        }
    }

    // Scroll the list while dragging near its edges.
    Timer {
        interval: 16ms;
        running: root.dragging && (root.drag-y < root.list-top + 28px || root.drag-y > root.list-top + list.height - 28px);
        triggered => {
            if (root.drag-y < root.list-top + 28px) {
                list.content-y = min(0px, list.content-y + 7px);
            } else {
                list.content-y = max(min(0px, list.height - list.content-height), list.content-y - 7px);
            }
        }
    }

    Timer {
        interval: 5s;
        running: root.menu-delete-armed;
        triggered => {
            root.menu-delete-armed = false;
        }
    }

    // The menu hands focus back as it opens a text box, so focus it a moment later.
    property <bool> rename-focus-pending;

    profile-menu := PopupWindow {
        x: min(root.menu-x, root.width - 288px);
        y: min(root.menu-y, root.height - 200px);
        width: 280px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000026;
            Timer {
                interval: 30ms;
                running: root.rename-focus-pending;
                triggered => {
                    root.rename-focus-pending = false;
                    rename-input.focus();
                    rename-input.select-all();
                }
            }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                if !root.menu-renaming: MenuRow {
                    label: "Rename";
                    clicked => {
                        rename-input.text = root.menu-profile.name;
                        root.menu-renaming = true;
                        root.rename-focus-pending = true;
                    }
                }

                Rectangle {
                    height: root.menu-renaming ? 36px : 0px;
                    visible: root.menu-renaming;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    rename-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        enabled: root.menu-renaming;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: Theme.text;
                        selection-background-color: Theme.accent-soft;
                        selection-foreground-color: Theme.text;
                        accepted => {
                            root.rename-profile-id(root.menu-profile.id, self.text);
                            root.menu-renaming = false;
                            profile-menu.close();
                            root.focus-input();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.menu-renaming = false;
                                profile-menu.close();
                                root.focus-input();
                                return accept;
                            }
                            reject
                        }
                    }
                }

                // Colour swatches: drawn 20 px (26 px with the ring) inside a 32 px target.
                HorizontalLayout {
                    height: 40px;
                    alignment: center;
                    for sw in root.swatches: Rectangle {
                        width: 32px;
                        height: 32px;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            border-width: sw.colour == root.menu-profile.colour ? 2px : 0px;
                            border-color: Theme.text;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: sw.colour;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.set-profile-colour(root.menu-profile.id, sw.hex);
                                profile-menu.close();
                            }
                        }
                    }
                }

                if root.profiles.length > 1: MenuRow {
                    label: !root.menu-delete-armed ? "Delete"
                        : root.menu-profile.tasks == 0 ? "Delete " + root.menu-profile.name + "?"
                        : root.menu-profile.tasks == 1 ? "Delete " + root.menu-profile.name + " and its task?"
                        : "Delete " + root.menu-profile.name + " and its " + root.menu-profile.tasks + " tasks?";
                    ink: Theme.danger;
                    clicked => {
                        if (root.menu-delete-armed) {
                            root.menu-delete-armed = false;
                            root.delete-profile-id(root.menu-profile.id);
                            profile-menu.close();
                        } else {
                            root.menu-delete-armed = true;
                        }
                    }
                }
            }
        }
    }

    // The task being dragged.
    if root.dragging: Rectangle {
        x: root.drag-x - root.grab-x;
        y: root.drag-y - root.grab-y;
        width: root.ghost-width;
        height: 44px;
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.accent-soft;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #0000002E;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            Rectangle {
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 1.5px;
                border-color: Theme.accent;
            }
            Text {
                text: root.drag-title;
                font-size: 13.5px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Text with a 1px shadow in the opposite tone, so it reads on any wallpaper.
// The root draws the shadow; the child draws the ink 1px up-left of it.
component InkText inherits Text {
    in property <bool> dark-bg;
    in property <color> ink: root.dark-bg ? #FFFFFF : Theme.text;
    color: root.dark-bg ? #000000a0 : #FFFFFFc0;
    Text {
        x: -1px;
        y: -1px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: root.font-family;
        font-size: root.font-size;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        overflow: root.overflow;
        color: root.ink;
    }
}

// Transparent desktop card: today's open tasks, tick to complete.
export component WidgetWindow inherits Window {
    title: "Nix Planner widget";
    no-frame: true;
    // Slint turns a press near an edge into Windows' own resize, which draws an outline
    // box over the widget; the grip does the resizing instead. Negative, not zero: the
    // cursor outruns the window while the grip grows it, and 0 counts that as "on the edge".
    resize-border-width: -100px;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;
    preferred-width: 260px;
    min-width: 180px;
    // Six rows to start with; resizing shows more or fewer.
    preferred-height: 222px;
    min-height: 90px;

    in property <[TaskItem]> tasks;
    in property <string> today;
    // Set from Rust after sampling the wallpaper behind the widget.
    in property <bool> dark-bg;
    // The profile on show, or "" when there is only one.
    in property <string> profile;

    callback toggle-task(int);
    callback open-app();
    callback start-move();
    // Resized by the grip itself: Windows' own resize loop draws an outline box over the
    // widget's see-through window.
    callback start-resize();
    callback resize-drag();

    // How far down the header and rows reach. Rust cuts the window to this (plus the
    // grip), so clicks below it land on the desktop; `reshape` says it needs redoing.
    out property <length> ink-height: 14px + 22px + 9px + max(1, rows.shown + (rows.shown < root.tasks.length ? 1 : 0)) * rows.row-h;
    callback reshape();
    changed ink-height => {
        root.reshape();
    }
    changed width => {
        root.reshape();
    }
    changed height => {
        root.reshape();
    }

    // Resize grip, larger than the main window's so it is easy to catch.
    Rectangle {
        x: parent.width - 24px;
        y: parent.height - 24px;
        width: 24px;
        height: 24px;
        Icon {
            width: 12px;
            height: 12px;
            commands: "M 14 6 L 6 14 M 14 11 L 11 14";
            stroke: root.dark-bg ? #FFFFFF : Theme.text;
            stroke-width: 1.4px;
            opacity: grip.has-hover ? 0.9 : 0.4;
        }
        grip := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize();
                }
            }
            moved => {
                if (self.pressed) {
                    root.resize-drag();
                }
            }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 9px;
        Rectangle {
            height: 22px;
            HorizontalLayout {
                spacing: 8px;
                InkText {
                    text: "Today";
                    font-family: Theme.serif;
                    font-size: 16px;
                    dark-bg: root.dark-bg;
                    ink: root.dark-bg ? #E8C9A6 : Theme.strength("now");
                }

                InkText {
                    text: root.profile == "" ? root.today : root.profile + " · " + root.today;
                    font-size: 11px;
                    dark-bg: root.dark-bg;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            TouchArea {
                double-clicked => {
                    root.open-app();
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.start-move();
                    }
                }
            }
        }

        // Rows are placed by hand rather than in a layout, so how many fit can follow the
        // window's height without the content's size feeding back into it.
        rows := Rectangle {
            property <length> row-h: 27px;
            property <int> shown: root.tasks.length * self.row-h <= self.height ? root.tasks.length
                : max(0, floor((self.height - 18px) / self.row-h));

            if root.tasks.length == 0: InkText {
                y: 0;
                height: 18px;
                text: "Nothing for today.";
                dark-bg: root.dark-bg;
            }
            for t[i] in root.tasks: HorizontalLayout {
                y: i * rows.row-h;
                height: 18px;
                visible: i < rows.shown;
                spacing: 10px;
                Check {
                    tint: root.dark-bg ? #FFFFFFc0 : Theme.text-muted;
                    toggled => {
                        root.toggle-task(t.id);
                    }
                }

                InkText {
                    text: t.title;
                    dark-bg: root.dark-bg;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if t.when != "": InkText {
                    text: t.when;
                    font-size: 11px;
                    dark-bg: root.dark-bg;
                    ink: t.overdue ? (root.dark-bg ? #F2A48F : Theme.danger)
                        : t.soon ? (root.dark-bg ? #E8C9A6 : Theme.accent)
                        : (root.dark-bg ? #FFFFFF : Theme.text);
                    vertical-alignment: center;
                }
            }
            if rows.shown < root.tasks.length: InkText {
                y: rows.shown * rows.row-h;
                height: 18px;
                text: "+" + (root.tasks.length - rows.shown) + " more";
                font-size: 11px;
                dark-bg: root.dark-bg;
            }
        }
    }
}
